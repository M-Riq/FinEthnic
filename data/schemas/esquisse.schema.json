{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finethnic.example/schemas/esquisse.schema.json",
  "title": "FinEthnic — esquisse grammaticale de l'éton (HAL) en JSON",
  "description": "Section 8 « Esquisse grammaticale » du Dictionnaire éton–français (HAL halshs-03847045, CC BY-NC-SA 4.0), convertie par scripts/convert-d7.ts : sections numérotées, paragraphes, tableaux et exemples numérotés gardés tels quels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "sections"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source": { "$ref": "d7.schema.json#/$defs/source" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "level", "blocks"],
        "properties": {
          "number": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 2 },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object", "additionalProperties": false, "required": ["type", "text"],
                  "properties": { "type": { "const": "paragraphe" }, "text": { "type": "string", "minLength": 1 } }
                },
                {
                  "type": "object", "additionalProperties": false, "required": ["type", "caption", "columns", "rows"],
                  "properties": {
                    "type": { "const": "tableau" },
                    "caption": { "type": ["string", "null"] },
                    "columns": { "type": "array", "items": { "type": "string" } },
                    "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
                  }
                },
                {
                  "type": "object", "additionalProperties": false, "required": ["type", "examples"],
                  "properties": {
                    "type": { "const": "exemples" },
                    "examples": {
                      "type": "array",
                      "items": {
                        "type": "object", "additionalProperties": false, "required": ["n", "text"],
                        "properties": { "n": { "type": "string", "pattern": "^(\\d+)?$" }, "text": { "type": "string" } }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}

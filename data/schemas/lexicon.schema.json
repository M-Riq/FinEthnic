{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finethnic.example/schemas/lexicon.schema.json",
  "title": "FinEthnic — lexique d'exécution",
  "description": "Fichier lu par le moteur (src/language/lexicon.json), généré par build-lexicon (BM5) à partir de data/. Il contient toutes les sources connues avec leur statut. Une cible Éton figure dans target seulement si l'entrée est approuvée ; la traduction non vérifiée retenue d'une entrée en attente figure dans un champ séparé, unverifiedTarget (contrat §5.2 et §5.4, décision Q9). Une cible rejetée n'y figure jamais (contrat I6). Aucune date de génération : même contenu de data/ = même fichier (I8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "libraryVersion",
    "targetLang",
    "variety",
    "entries"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "libraryVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetLang": {
      "const": "eto"
    },
    "variety": {
      "const": "obala"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lexiconEntry"
      }
    }
  },
  "$defs": {
    "lexiconSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "variants"
      ],
      "properties": {
        "text": {
          "$ref": "entry.schema.json#/$defs/text"
        },
        "variants": {
          "$ref": "entry.schema.json#/$defs/textList"
        }
      }
    },
    "lexiconEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "sources",
        "variables",
        "target",
        "unverifiedTarget"
      ],
      "properties": {
        "id": {
          "$ref": "entry.schema.json#/$defs/entryId"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "untranslated",
            "protected",
            "out-of-scope"
          ],
          "description": "approved → APPROVED (cible dans output) ; pending → PENDING_VALIDATION (cible dans unverifiedOutput, décision Q9) ; untranslated → KNOWN_UNTRANSLATED ; protected → PROTECTED (protected-entry) ; out-of-scope → PROTECTED (out-of-scope). Contrat §5.2."
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Une source EN n'est embarquée que si sa correspondance FR↔EN est validée (T-LIB-11).",
          "properties": {
            "fr": {
              "$ref": "#/$defs/lexiconSource"
            },
            "en": {
              "$ref": "#/$defs/lexiconSource"
            }
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "entry.schema.json#/$defs/variable"
          }
        },
        "contextHints": {
          "$ref": "entry.schema.json#/$defs/contextHints"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traduction approuvée par une locutrice. Non nulle si et seulement si status = approved. Seul ce champ peut alimenter output (contrat I3)."
        },
        "unverifiedTarget": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traduction non vérifiée retenue (contrat §5.2, décision Q9) : target.eto.text, sinon la première proposition de la cascade. Non nulle si et seulement si status = pending. Ce champ n'alimente que unverifiedOutput : il est séparé de target pour qu'une traduction non vérifiée ne puisse jamais sortir dans output."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "target": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "unverifiedTarget": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "unverifiedTarget": {
                "type": "null"
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}

{
  "name": "finethnic",
  "version": "0.0.0",
  "private": true,
  "description": "FinEthnic — prototype SAFINUM Éton : bibliothèque linguistique, moteur local et extension Chrome",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json",
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "validate-data": "tsx scripts/validate-data.ts",
    "import-sources": "tsx scripts/import-sources.ts",
    "check-duplicates": "tsx scripts/check-duplicates.ts",
    "export-l1": "tsx scripts/export-l1.ts",
    "import-dictionary": "tsx scripts/import-dictionary.ts",
    "propose-translations": "tsx scripts/propose-translations.ts",
    "build-lefff": "tsx scripts/build-lefff.ts",
    "serve-engine": "tsx scripts/serve-engine.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
